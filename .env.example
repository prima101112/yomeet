# ---- Required ----
ELEVENLABS_API_KEY=            # needs text-to-speech and speech-to-text access

# ---- Brain ----
BRAIN=claude-code              # "claude-code" (your Claude Code login, via `claude -p`) or "api"
# CLAUDE_CODE_OAUTH_TOKEN=     # from `claude setup-token` (recommended); otherwise ~/.claude/.credentials.json is mounted
# ANTHROPIC_API_KEY=           # only for BRAIN=api
# CLAUDE_MODEL=claude-opus-5-5
# CLAUDE_BIN=claude            # only used with SANDBOX=none
# SANDBOX=docker               # "none" = no sandbox and no file tools (web search only)
# WORKSPACE=~/yomeetnotes      # the only folder the bot's Claude Code can see
# WORKSPACE_SHELL=false        # true = also bash/python in the workspace (see "Security" in README)
# WEB_SEARCH=true

# ---- Bot ----
BOT_NAME=YoMeet                # shown in Meet; also the main wake word. Real words (e.g. Nova) are recognized more reliably
# WAKE_WORDS=                  # comma-separated; empty = bot name (+ mishearings) + "claude" + "hey assistant"
# ONE_ON_ONE=true              # when it's just you and the bot, answer everything without the wake word
# FOLLOWUP_SEC=15              # after an answer, follow-ups don't need the wake word for this long
# LANGUAGE=                    # e.g. en, id; empty = auto-detect
# ELEVENLABS_VOICE_ID=         # empty = first premade voice (George if the key can't list voices)
# ELEVENLABS_TTS_MODEL=eleven_flash_v2_5
# ELEVENLABS_STT_MODEL=scribe_v1
# PROFILE_DIR=                 # signed-in Chrome profile; set by the dashboard's "Sign in to Google"
# NOTES_DIR=~/yomeetnotes/meetings

# ---- Tuning ----
# VAD_THRESHOLD=350            # raise if background noise gets transcribed
# SILENCE_MS=900               # raise if people get cut off mid-sentence
# ADMIT_TIMEOUT_MIN=10
# ALONE_TIMEOUT_MIN=3
# MAX_DURATION_MIN=180

# ---- Dashboard (npm run server) ----
# DASHBOARD_PASSWORD=          # built-in basic auth (user DASHBOARD_USER, default "admin"); required if HOST isn't loopback
# VNC_URL=                     # link to a VNC/noVNC view of the bots' display, shown for the Google sign-in
